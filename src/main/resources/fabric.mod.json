{
  "schemaVersion": 1,
  "id": "smart_worker",
  "version": "${version}",
  "name": "Smart Worker",
  "description": "Server-authoritative workers that collect items, mine configured resources, and learn useful and dangerous areas.",
  "authors": ["Smart Worker contributors"],
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": ["dev.smartworker.SmartWorkerMod"],
    "client": ["dev.smartworker.client.SmartWorkerClient"]
  },
  "mixins": [
    {
      "config": "smart_worker.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~26.3",
    "java": ">=25",
    "fabric-api": "*"
  }
}
